{
  "name": "@harms-haus/pi-orca",
  "version": "0.1.0",
  "description": "Pi extension with tools for driving the Orca IDE: profile-configured subagents, terminals, tabs, and the embedded browser",
  "keywords": [
    "orca",
    "pi-coding-agent",
    "pi-package",
    "subagent",
    "browser"
  ],
  "license": "MIT",
  "author": "Blake Harms <blake@harms.haus>",
  "files": [
    "src/**/*.ts",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "src/index.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "vp check && npm run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "vp test",
    "smoke": "jiti scripts/smoke.ts"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "22.20.1",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "typebox": "1.3.7",
    "typescript": "7.0.2",
    "vite-plus": "0.2.9",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.23.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
